rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == "koteswararaobotchu007@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // Projects: Anyone can read, only admin can write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Experiences: Anyone can read, only admin can write
    match /experiences/{expId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Certificates: Anyone can read, only admin can write
    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials: Anyone can read the public carousel, only admin can write
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Messages: Anyone can create a validated message, only admin can read
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'unread'
        && request.resource.data.createdAt is string;
      allow read, update, delete: if isAdmin();
    }

    // Settings: Anyone can read public profile info, only admin can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Analytics: Visitors may increment the counter by exactly one
    match /analytics/visitors {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // Visitor logs: Anyone can append to the public log and read it
    match /visitor_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['city', 'timestamp'])
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 100
        && request.resource.data.timestamp is string;
      allow update, delete: if false;
    }

    // Users: Users can read/write their own data, admin can read all
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAdmin();
    }
  }
}
