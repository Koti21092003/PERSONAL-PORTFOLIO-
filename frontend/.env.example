# Optional: override the notification endpoint during local development.
# VITE_NOTIFY_ENDPOINT=http://localhost:8888/.netlify/functions/notify-message

# Optional: point the chat widget at a locally running Netlify Function.
# VITE_CHAT_ENDPOINT=http://localhost:8888/.netlify/functions/chat

# Email notifications run in a Netlify Function. Configure these in the
# Netlify dashboard (Site configuration -> Environment variables), not here:
# RESEND_API_KEY=re_xxxxxxxxx
# NOTIFICATION_EMAIL=koteswararaobotchu007@gmail.com
# RESEND_FROM_EMAIL=Portfolio Notifications <onboarding@resend.dev>

# AI answers are optional. By default the assistant uses a keyless AI fallback.
# Add ONE provider key in the Netlify dashboard for better reliability:
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...
# AI_API_KEY=sk-...
# Optional overrides:
# AI_MODEL=openai/gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_KEYLESS=false
# AI_KEYLESS_URL=https://your-keyless-endpoint/v1/chat/completions
# AI_KEYLESS_MODEL=openai
# SITE_URL=https://koteswararaoportfolioo.netlify.app
